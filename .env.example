# Copia este archivo como .env y completa con tus credenciales de Supabase
# Encuéntralas en: tu proyecto Supabase > Settings > API

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Variables del Edge Function send-maintenance-email (configurar como secretos en Supabase)
# supabase secrets set RESEND_API_KEY=...
# supabase secrets set EMAIL_FROM="SECCO <no-reply@tu-dominio.cl>"
# supabase secrets set EMAIL_REPLY_TO="contacto@tu-dominio.cl"
